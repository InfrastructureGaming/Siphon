<Window x:Class="Siphon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Siphon.App"
        xmlns:controls="clr-namespace:Siphon.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="Siphon" Width="300" Height="380"
        ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsPinned}"
        Background="{StaticResource FaceplateBrush}"
        Foreground="{StaticResource LabelBrush}"
        FontFamily="{StaticResource UiFont}" FontWeight="Medium" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />   <!-- drag bar -->
                <RowDefinition Height="Auto" /> <!-- source picker -->
                <RowDefinition Height="*" />    <!-- record button -->
                <RowDefinition Height="Auto" /> <!-- timer + status -->
                <RowDefinition Height="Auto" /> <!-- meter -->
                <RowDefinition Height="Auto" /> <!-- footer -->
            </Grid.RowDefinitions>

            <!-- Drag bar -->
            <DockPanel Grid.Row="0" Margin="12,0,4,0" LastChildFill="False">
                <Path DockPanel.Dock="Left" VerticalAlignment="Center" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0">
                    <Path.Data>
                        <GeometryGroup>
                            <EllipseGeometry Center="1.5,1.5" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="5.5,1.5" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="1.5,5.5" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="5.5,5.5" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="1.5,9.5" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="5.5,9.5" RadiusX="1.2" RadiusY="1.2" />
                        </GeometryGroup>
                    </Path.Data>
                </Path>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Siphon"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" />

                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontSize="10"
                        ToolTip="Close" Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10"
                        ToolTip="Minimize" Click="OnMinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True" />
                <ToggleButton x:Name="PinButton" DockPanel.Dock="Right" IsChecked="{Binding IsPinned}"
                              WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE718;" />
                            <Setter Property="ToolTip" Value="Keep on top" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="&#xE840;" />
                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                    <Setter Property="ToolTip" Value="Stop keeping on top" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </DockPanel>

            <!-- Source picker -->
            <ComboBox Grid.Row="1" Margin="16,6,16,0" Style="{StaticResource SourcePicker}"
                      ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      IsEnabled="{Binding IsRecording, Converter={StaticResource Not}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="local:SourceOption">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Record button -->
            <Button x:Name="RecordButton" Grid.Row="2" Style="{StaticResource RecordButton}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Command="{Binding ToggleRecordCommand}"
                    AutomationProperties.Name="Record"
                    ToolTip="Record (Space)" />

            <!-- Timer and status -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ElapsedText}" FontSize="32" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"
                           Margin="0,-6,0,0" />
                <TextBlock Text="{Binding StatusText}" FontSize="13" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" MinHeight="17" Margin="0,-2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsNotice}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Level meter -->
            <Grid Grid.Row="4" Margin="24,12,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="9" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="9" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="L" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,-3,0,-3" />
                <TextBlock Grid.Row="2" Text="R" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,-3,0,-3" />
                <controls:SegmentMeter Grid.Row="0" Grid.Column="1" Level="{Binding LevelLeft}"
                                       LitBrush="{StaticResource AmberBrush}" HotBrush="{StaticResource LampRedBrush}"
                                       IdleBrush="{StaticResource MeterIdleBrush}" />
                <controls:SegmentMeter Grid.Row="2" Grid.Column="1" Level="{Binding LevelRight}"
                                       LitBrush="{StaticResource AmberBrush}" HotBrush="{StaticResource LampRedBrush}"
                                       IdleBrush="{StaticResource MeterIdleBrush}" />
            </Grid>

            <!-- Footer: last file (drag me), open folder -->
            <Border Grid.Row="5" Background="{StaticResource PanelBrush}" Height="40">
                <Grid Margin="8,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LastFileRow" Grid.Column="0" Background="Transparent" CornerRadius="4" Padding="6,0"
                            Height="30" ToolTip="{Binding LastFilePath}"
                            MouseLeftButtonDown="OnLastFileMouseDown" MouseMove="OnLastFileMouseMove">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding HasLastFile}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
                                        <Setter Property="Cursor" Value="SizeAll" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE700;" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="200">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding LastFileName, StringFormat='Saved {0}'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLastFile}" Value="False">
                                                <Setter Property="Text" Value="No recordings yet" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE838;" FontSize="14"
                            ToolTip="Show in folder" Command="{Binding OpenFolderCommand}" />

                    <!-- Hit-testing is off while the popover is open, so a click here closes it instead of reopening it. -->
                    <ToggleButton x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                  Content="&#xE713;" FontSize="14" ToolTip="Settings"
                                  IsChecked="{Binding IsOpen, ElementName=SettingsPopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=SettingsPopup, Converter={StaticResource Not}}" />
                </Grid>
            </Border>

            <!-- Settings popover, rising out of the footer. -->
            <Popup x:Name="SettingsPopup" Grid.Row="5" StaysOpen="False" AllowsTransparency="True"
                   PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Top"
                   HorizontalOffset="-252" VerticalOffset="-6" PopupAnimation="Fade"
                   Opened="OnSettingsOpened" PreviewKeyDown="OnSettingsKeyDown">
                <Border Width="276" Margin="0,0,0,8" Padding="14,12,14,14" CornerRadius="8"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                        TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontWeight="Medium"
                        TextElement.Foreground="{StaticResource LabelBrush}" TextElement.FontSize="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Output folder" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OutputFolder}" ToolTip="{Binding OutputFolder}" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                            <Button x:Name="ChangeFolderButton" Grid.Column="1" Style="{StaticResource PanelButton}"
                                    Content="Change…" Command="{Binding ChangeOutputFolderCommand}" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource EdgeBrush}" Margin="0,12" />

                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsPinned}">
                            <TextBlock Text="Always on top" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
